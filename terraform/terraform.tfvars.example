# Non-secret example values; review region and expected costs before any cloud work.
aws_region           = "us-east-1"
cluster_name         = "gamesense-m10"
environment          = "demo"
vpc_cidr             = "10.42.0.0/16"
public_subnet_cidrs  = ["10.42.1.0/24", "10.42.2.0/24"]
private_subnet_cidrs = ["10.42.11.0/24", "10.42.12.0/24"]
node_instance_types  = ["t3.medium"]
node_min_size        = 1
node_max_size        = 3
node_desired_size    = 2
