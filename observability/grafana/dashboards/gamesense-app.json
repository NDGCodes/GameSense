{
  "title": "GameSense Application Metrics",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Recommendation Requests",
      "targets": [{ "expr": "sum(gamesense_requests_total{route=\"/api/recommendations\"})" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Recommendation Latency p95",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(gamesense_recommendation_seconds_bucket[5m])) by (le))" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    }
  ]
}
